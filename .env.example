# ═══════════════════════════════════════════════════════════════════════════════
# Gap Analysis API — шаблон переменных окружения
#
# Скопируйте этот файл:
#   cp .env.example .env
# Затем заполните значения ниже.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# ВАЖНО: POSTGRES_USER, POSTGRES_PASSWORD и POSTGRES_DB должны быть идентичны
# значениям, указанным в строке DATABASE_URL ниже.
# Если вы хотите задать собственные логин и пароль — измените их ВЕЗДЕ:
# и в POSTGRES_USER/PASSWORD, и в DATABASE_URL.

POSTGRES_USER=gapuser
POSTGRES_PASSWORD=gappassword
POSTGRES_DB=gapanalysis

# URL соединения с БД (используется FastAPI-контейнером).
# Хост "db" — это внутреннее DNS-имя сервиса PostgreSQL в Docker Compose.
# Не меняйте хост "db"; меняйте только логин, пароль и имя базы.
DATABASE_URL=postgresql+asyncpg://gapuser:gappassword@db:5432/gapanalysis

# ─── Thordata / SerpApi ────────────────────────────────────────────────────────
# Ключ для получения Google AI Overview через шлюз Thordata.
# Зарегистрируйтесь на thordata.com и вставьте ваш ключ ниже.
SERPAPI_KEY=

# URL шлюза Thordata (уточните в личном кабинете или документации Thordata).
# По умолчанию используется публичный эндпоинт SerpApi.
SERPAPI_URL=https://serpapi.com/search

# ─── LLM (OpenAI или OpenRouter) ──────────────────────────────────────────────
# Укажите ОДИН из ключей. Если заданы оба, приоритет у OPENAI_API_KEY.

# Ключ OpenAI
OPENAI_API_KEY=

# Ключ OpenRouter (доступ к Claude, Gemini, Llama и др.)
OPENROUTER_API_KEY=

# Модель для анализа. Примеры:
#   OpenAI:     gpt-4o-mini, gpt-4o
#   OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENAI_MODEL=gpt-4o-mini

# Переопределение base URL (необязательно).
# Для OpenRouter: https://openrouter.ai/api/v1
# Оставьте пустым при использовании OpenAI напрямую.
OPENAI_BASE_URL=
