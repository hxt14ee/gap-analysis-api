# ── PostgreSQL ─────────────────────────────────────────────────────────────
# ВАЖНО: POSTGRES_USER и POSTGRES_PASSWORD должны совпадать с DATABASE_URL.
# Хост "db" — внутреннее DNS-имя контейнера в Docker Compose.
POSTGRES_USER=gapuser
POSTGRES_PASSWORD=gappassword
POSTGRES_DB=gapanalysis
DATABASE_URL=postgresql+asyncpg://gapuser:gappassword@db:5432/gapanalysis

# ── Thordata SERP API ───────────────────────────────────────────────────────
# Ключ из https://dashboard.thordata.com/serp-api
SERPAPI_KEY=
SERPAPI_URL=https://scraperapi.thordata.com/request

# ── LLM ────────────────────────────────────────────────────────────────────
# Приоритет: OPENROUTER_API_KEY → OPENAI_API_KEY
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Для OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-haiku и др.
# Для OpenAI:     gpt-4o-mini, gpt-4o
OPENAI_MODEL=openai/gpt-4o-mini
# Оставьте пустым — устанавливается автоматически для выбранного провайдера
OPENAI_BASE_URL=
