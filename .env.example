# ═══════════════════════════════════════════════════════════════════════════════
# Gap Analysis API — шаблон переменных окружения
#
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# ВАЖНО: POSTGRES_USER и POSTGRES_PASSWORD должны быть ИДЕНТИЧНЫ значениям
# в строке DATABASE_URL. Если хотите свои учётные данные — меняйте ВСЁ СРАЗУ:
#   POSTGRES_USER, POSTGRES_PASSWORD и соответствующие части DATABASE_URL.

POSTGRES_USER=gapuser
POSTGRES_PASSWORD=gappassword
POSTGRES_DB=gapanalysis

# Хост "db" — внутреннее DNS-имя сервиса PostgreSQL в Docker Compose.
# Не меняйте хост; меняйте только логин, пароль и имя базы.
DATABASE_URL=postgresql+asyncpg://gapuser:gappassword@db:5432/gapanalysis

# ─── Thordata SERP API ─────────────────────────────────────────────────────────
# Регистрация и ключ: https://dashboard.thordata.com/serp-api
# SERPAPI_KEY передаётся как параметр "token" в каждом запросе.
# ai_overview=true передаётся автоматически — не нужно добавлять вручную.
SERPAPI_KEY=

# Эндпоинт Thordata ScraperAPI (ключ передаётся через заголовок Authorization: Bearer)
SERPAPI_URL=https://scraperapi.thordata.com/request

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Приоритет: OPENROUTER_API_KEY → OPENAI_API_KEY.
# Достаточно задать ОДИН ключ.

# OpenRouter (приоритетный, даёт доступ к Claude, Gemini, GPT и др.)
# Регистрация: https://openrouter.ai
OPENROUTER_API_KEY=

# OpenAI (резервный вариант)
OPENAI_API_KEY=

# Модель:
#   OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-flash-1.5
#   OpenAI:     gpt-4o-mini, gpt-4o
OPENAI_MODEL=openai/gpt-4o-mini

# Переопределение base URL (оставьте пустым — устанавливается автоматически)
OPENAI_BASE_URL=
