# ──────────────────────────────────────────────────
# Gap Analysis API — переменные окружения
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ──────────────────────────────────────────────────

# URL подключения к PostgreSQL (используется внутри Docker)
DATABASE_URL=postgresql+asyncpg://gapuser:gappassword@db:5432/gapanalysis

# Пароль базы данных (должен совпадать с паролем в docker-compose.yml)
POSTGRES_PASSWORD=gappassword

# Модель OpenAI / OpenRouter для анализа (по умолчанию gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Ключ OpenAI API (оставьте пустым для работы в режиме mock)
OPENAI_API_KEY=

# Ключ OpenRouter API (альтернатива OpenAI; оставьте пустым если не используется)
OPENROUTER_API_KEY=
